    {
        "id": "41c871da07265d7b",
        "type": "function",
        "z": "1e70f007fa765a8f",
        "name": "agreaga todo",
        "func": "// fecha por defecto es hoy\nvar ahora = new Date();\n// pillo los globales si los hay, si no la fecha de hoy\nvar desde = new Date(global.get(\"desde\") || ahora);\nvar hasta = new Date(global.get(\"hasta\") || ahora); \n// el día de inicio desde las cero horas\nvar inicio = new Date(desde.getFullYear(),desde.getMonth(),desde.getDate(),1,0,0,0);\n// el día final es hasta final del día\nvar final = new Date(hasta.getFullYear(),hasta.getMonth(),hasta.getDate(),23,59,59,99);\n\n// usuario desde el flow\nvar usuario = flow.get(\"usuario\");\n\n\nmsg.payload=\n[\n    { \"$match\": { \"date\": { \"$gte\": inicio , \"$lte\": final },\n                  \"usuario\" : usuario }\n                                          \n     \n    },\n   \n    { \"$project\": {\n        \"usuario\": 1,  // campo usuario\n        \"nivel\": 1    // campo nivel\n\n        }\n    },\n    { \"$group\": {\n        \"_id\": \"$usuario\",  // Agrupamos por usuario\n        \"nivelMax\": { \"$max\": \"$nivel\" },   // Calculamos el nivel máximo\n        \"nivelMin\": { \"$min\": \"$nivel\" },   // Calculamos el nivel mínimo\n        \"nivelProm\": { \"$avg\": \"$nivel\" },  // Calculamos el promedio de nivel\n        \"datos\": { \"$sum\": 1 }              // Contamos la cantidad de registros por usuario\n\n    }},\n    { \"$sort\": { \"_id\": 1 } } //se vuelve a ordenar pq al agrupar, aparecen desordenados\n    \n    \n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1760,
        "y": 880,
        "wires": [
            [
                "4bacaa31b0e2e712"
            ]
        ]
    },
