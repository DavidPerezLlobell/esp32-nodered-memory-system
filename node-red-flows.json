    {
        "id": "fb0221ad3015ffc5",
        "type": "function",
        "z": "1e70f007fa765a8f",
        "name": "agrega grafica",
        "func": "// fecha por defecto es hoy\nvar ahora = new Date();\n\n// pillo los globales si los hay, si no la fecha de hoy\nvar desde = new Date(global.get(\"desde\") || ahora);\nvar hasta = new Date(global.get(\"hasta\") || ahora); \n\n// el día de inicio desde las cero horas\nvar inicio = new Date(desde.getFullYear(),desde.getMonth(),desde.getDate(),1,0,0,0);\n// el día final es hasta final del día\nvar final = new Date(hasta.getFullYear(),hasta.getMonth(),hasta.getDate(),23,59,59,99);\n\n\n// usuario desde el flow\nvar usuario = flow.get(\"usuario\");\n\nmsg.payload=\n[\n    { \"$match\": { \"usuario\": usuario, \"date\": { \"$gte\": inicio , \"$lte\": final } } },\n    { \"$project\": {\n            \"date\": 1,\n            \"nivel\": 1\n        }\n    },\n    { \"$sort\": { \"date\": 1 } } \n    \n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1750,
        "y": 980,
        "wires": [
            [
                "8cc697b5cc563bcb"
            ]
        ]
    },
    {
        "id": "260b6172abcc9366",
        "type": "function",
        "z": "1e70f007fa765a8f",
        "name": "genera datos gráfica",
        "func": "var arrayavg=[];\nvar arraymax=[];\nvar arraymin=[];\n\nvar total = 0;\nvar count = 0;\nvar max = null;\nvar min = null;\n\nif(Array.isArray(msg.payload) && msg.payload.length>0)\n{\n    for (var i = 0; i < msg.payload.length; i++) {\n        \n        var nivel = msg.payload[i].nivel;\n        var dia = new Date(msg.payload[i].date);\n\n        // acumulativo\n        total += nivel;\n        count += 1;\n        max = max === null ? nivel : Math.max(max, nivel);\n        min = min === null ? nivel : Math.min(min, nivel);\n        var avg = total / count;\n\n        arrayavg.push({ x: dia.getTime(), y: avg });\n        arraymax.push({ x: dia.getTime(), y: max });\n        arraymin.push({ x: dia.getTime(), y: min });\n    }\n    \n}\n    \nmsg.payload = [{\n    \"series\": [\"Nivel medio\", \"Nivel max\", \"Nivel min\"],\n        \"data\":[arrayavg, arraymax, arraymin],\n        \"labels\":[\"\"]\n        }];\n\n\n\nreturn msg;  ",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 2350,
        "y": 980,
        "wires": [
            [
                "64ce3e0d3dfd9efd"
            ]
        ]
    },
